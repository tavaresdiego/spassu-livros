{#
    Campo de texto fora do Symfony Form. help e error ficam ligados ao input por aria-describedby.
    Estados: error (is-invalid + aria-invalid), disabled/required via atributos.
#}
{% props name = null, label = null, type = 'text', value = null, placeholder = null, help = null, error = null %}
{% set id = attributes.render('id') ?? ('input-' ~ name) %}
{% set describedBy = [help ? id ~ '-help' : null, error ? id ~ '-error' : null]|filter(v => v) %}
<div class="app-field">
    {% if label %}<label for="{{ id }}" class="form-label">{{ label }}</label>{% endif %}
    <input type="{{ type }}" id="{{ id }}" name="{{ name }}" value="{{ value }}"
        {%- if placeholder %} placeholder="{{ placeholder }}"{% endif %}
        {%- if describedBy is not empty %} aria-describedby="{{ describedBy|join(' ') }}"{% endif %}
        {%- if error %} aria-invalid="true"{% endif %}
        {{ attributes.defaults({class: 'form-control form-control-sm' ~ (error ? ' is-invalid' : '')}) }}>
    {% if error %}<div id="{{ id }}-error" class="invalid-feedback">{{ error }}</div>{% endif %}
    {% if help %}<div id="{{ id }}-help" class="form-text">{{ help }}</div>{% endif %}
</div>

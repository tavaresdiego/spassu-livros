{% extends 'admin/_form_page.html.twig' %}
{% set heading = entity.codl ? 'Editar livro' : 'Novo livro' %}
{% set back_route = 'admin_livro_index' %}
{% set section_label = 'Livros' %}

{% block stylesheets %}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" crossorigin="anonymous">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" crossorigin="anonymous">
{% endblock %}

{% block javascripts %}
    {# Select2 depende de jQuery; carregados só nesta página #}
    <script src="https://code.jquery.com/jquery-3.7.1.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js" crossorigin="anonymous"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/i18n/pt-BR.js" crossorigin="anonymous"></script>
{% endblock %}

{% block fields %}
    <div class="row g-3">
        <div class="col-12">{{ form_row(form.titulo) }}</div>
        <div class="col-6 col-md-3">{{ form_row(form.editora) }}</div>
        <div class="col-6 col-md-3">{{ form_row(form.edicao) }}</div>
        <div class="col-6 col-md-3">{{ form_row(form.anoPublicacao) }}</div>
        <div class="col-6 col-md-3">{{ form_row(form.valor) }}</div>
        <div class="col-12 col-lg-6 pt-lg-4">{{ form_row(form.autores) }}</div>
        <div class="col-12 col-lg-6 pt-lg-4">{{ form_row(form.assuntos) }}</div>
        <div class="px-2 w-100 py-4 my-4 border-top border-bottom">
            <p class="mb-1 fw-medium form-text">Imagens do livro</p>
            <div class="d-flex gap-3 p-3 bg-light flex-wrap rounded">
                <div class="col-12">{{ form_row(form.imagemMobileUrl) }}</div>
                <div class="col-12">{{ form_row(form.imagemDesktopUrl) }}</div>
                {# {{ form_row(form.imagemDesktopUrl, {attr: {class: 'form-control-sm'}}) }} #}
            </div>
        </div>
        <div class="col-12">{{ form_row(form.descricao) }}</div>
    </div>
    {{ form_rest(form) }}
{% endblock %}
